# ===================================================================
# 🚀 Bioprocess Analytics - Centralized Environment Configuration
# ===================================================================
# This single file contains all environment variables for the entire system
# Place this file in the root directory of your project

# ===================================================================
# 🎯 Application Settings
# ===================================================================
ENVIRONMENT=development
SERVICE_NAME=bioprocess-analytics
SERVICE_PORT=8080
SERVICE_HOST=0.0.0.0
SERVICE_WORKERS=1
LOG_LEVEL=INFO
LOG_FORMAT=text

# ===================================================================
# 🔐 Security Settings
# ===================================================================
# Using your existing 64-character key
SECRET_KEY=4mZ8hXuJ7nK2pQ9sT5vW3rY6bN1cF4eG8jH0kL9mN2oP7qR3sT5uV8wXyZ1aB2cD3eF4gH5iJ6kL7mN8oP9qR
FERNET_KEY=your-fernet-encryption-key-32-bytes-base64-encoded-1234567890abcdef=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20

# ===================================================================
# 🗄️ Database Configuration
# ===================================================================
AUTH_DATABASE_URL=postgresql+psycopg2://authuser:password@db_auth:5432/authdb
USER_DATABASE_URL=postgresql+psycopg2://useruser:password@db_user:5432/userdb
BATCH_DATABASE_URL=postgresql+psycopg2://batchuser:password@db_batch:5432/batchdb

# Database performance settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_ECHO=false

# ===================================================================
# 🔄 Redis Configuration
# ===================================================================
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_RETRY_ON_TIMEOUT=true
REDIS_HEALTH_CHECK_INTERVAL=30

# ===================================================================
# 📊 Monitoring & Observability
# ===================================================================
JAEGER_AGENT_HOST=jaeger
JAEGER_AGENT_PORT=6831
JAEGER_SAMPLER_TYPE=const
JAEGER_SAMPLER_PARAM=1.0
METRICS_PORT=9090
METRICS_PATH=/metrics
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000

# ===================================================================
# 🔍 Feature Flags
# ===================================================================
ENABLE_TRACING=true
ENABLE_METRICS=true
ENABLE_RATE_LIMITING=true
ENABLE_CORS=true
ENABLE_SSL=false
DEBUG=true
DEBUG_SQL=false
AUTO_RELOAD=true
HOT_RELOAD=true

# ===================================================================
# 🌐 CORS Configuration
# ===================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080

# ===================================================================
# 📡 Service URLs (Internal Docker Network)
# ===================================================================
AUTH_SERVICE_URL=http://auth:9001
USER_SERVICE_URL=http://user:9002
BATCH_SERVICE_URL=http://batch:9003
GATEWAY_URL=http://gateway:8080

# ===================================================================
# 🔒 SSL/TLS Configuration
# ===================================================================
SSL_CERT_PATH=/etc/ssl/certs/cert.pem
SSL_KEY_PATH=/etc/ssl/private/key.pem
SSL_PROTOCOLS=TLSv1.2,TLSv1.3
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# ===================================================================
# 💾 Backup Configuration
# ===================================================================
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_ENCRYPTION_KEY=your-backup-encryption-key

# ===================================================================
# 🚨 Alerting Configuration
# ===================================================================
ALERT_MANAGER_URL=http://alertmanager:9093
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=abhilashmohan@gmail.com
EMAIL_PASSWORD=SindhuMathai99

# ===================================================================
# 🌡️ Performance Tuning
# ===================================================================
CONNECTION_POOL_SIZE=20
CONNECTION_MAX_OVERFLOW=30
CONNECTION_POOL_TIMEOUT=30
REQUEST_TIMEOUT=30
CONNECT_TIMEOUT=10
READ_TIMEOUT=30
CACHE_TTL=3600
CACHE_MAX_SIZE=1000